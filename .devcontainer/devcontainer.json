{
  "name": "PrepFlow Workbench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-workbench.sh",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "PrepFlow Workbench",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "bins-projects/PrepFlow": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    }
  }
}
